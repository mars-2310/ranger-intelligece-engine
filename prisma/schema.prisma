generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum RangerColor {
  GREEN
  AMBER
  RED
  BLACK
}

enum MessageRole {
  SYSTEM
  RANGER
  WATCHTOWER
}

model Ranger {
  id          String        @id @default(uuid())
  email       String    @unique
  callSign    String        @unique
  color       RangerColor   @default(GREEN)
  createdAt   DateTime      @default(now())

  chats       ChatWindow[]
  documents   IntelDocument[]
}

model IntelDocument {
  id          String        @id @default(uuid())
  ranger      Ranger?       @relation(fields: [rangerId], references: [id])
  rangerId    String?

  title       String
  filename    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  ingestedAt  DateTime      @default(now())

  vectors     VectorRef[]
  rootChats   ChatWindow[]
  messages    ChatMessage[]
}

model VectorRef {
  id          String         @id @default(uuid())
  doc         IntelDocument  @relation(fields: [docId], references: [id])
  docId       String
  pineconeId  String         @unique
  namespace   String?
  chunkIndex  Int?
  page        Int?
  metadata    Json?

  createdAt   DateTime       @default(now())

  @@index([docId])
}

model ChatWindow {
  id          String        @id @default(uuid())
  ranger      Ranger        @relation(fields: [rangerId], references: [id])
  rangerId    String
  title       String?
  rootDoc     IntelDocument? @relation(fields: [rootDocId], references: [id])
  rootDocId   String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  messages    ChatMessage[]

  @@index([rangerId, createdAt])
}

model ChatMessage {
  id            String       @id @default(uuid())
  chat          ChatWindow   @relation(fields: [chatId], references: [id])
  chatId        String

  role          MessageRole
  content       String       @db.Text
  createdAt     DateTime     @default(now())

  // OPTIONAL: which doc this message is mainly about
  doc           IntelDocument? @relation(fields: [docId], references: [id])
  docId         String?

  context       Json?

  @@index([chatId, createdAt])
}